#!/bin/sh
# Regenerates Verse.xcodeproj when project.yml or the file list changed.
# Called by post-merge (git pull) and post-checkout (branch switch).
cd "$(git rev-parse --show-toplevel)" || exit 0
if ! command -v xcodegen >/dev/null 2>&1; then
  echo "verse: xcodegen not found — run 'brew install xcodegen', then 'xcodegen'."
  exit 0
fi
xcodegen --quiet && echo "verse: regenerated Verse.xcodeproj"
